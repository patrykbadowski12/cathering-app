{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Catering API",
    "version" : "1.0.0"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "tags" : [ {
    "description" : "Diet plans offered to customers",
    "name" : "DietPlanShop"
  }, {
    "description" : "Diet plan management for the catering owner",
    "name" : "DietPlanAdmin"
  } ],
  "paths" : {
    "/api/v1/admin/diet-plans" : {
      "post" : {
        "operationId" : "createAdminDietPlan",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateDietPlanRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DietPlanResponse"
                }
              }
            },
            "description" : "Diet plan created"
          }
        },
        "tags" : [ "DietPlanAdmin" ]
      }
    },
    "/api/v1/admin/diet-plans/{id}" : {
      "get" : {
        "operationId" : "getAdminDietPlan",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DietPlanResponse"
                }
              }
            },
            "description" : "Diet plan"
          },
          "404" : {
            "description" : "Diet plan not found"
          }
        },
        "tags" : [ "DietPlanAdmin" ]
      }
    },
    "/api/v1/shop/diet-plans" : {
      "get" : {
        "operationId" : "listShopDietPlans",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/DietPlanResponse"
                  }
                }
              }
            },
            "description" : "Diet plans of the current tenant"
          }
        },
        "tags" : [ "DietPlanShop" ]
      }
    },
    "/api/v1/shop/diet-plans/{id}" : {
      "get" : {
        "operationId" : "getShopDietPlan",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DietPlanResponse"
                }
              }
            },
            "description" : "Diet plan"
          },
          "404" : {
            "description" : "Diet plan not found"
          }
        },
        "tags" : [ "DietPlanShop" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "CreateDietPlanRequest" : {
        "type" : "object",
        "properties" : {
          "kcal" : {
            "type" : "integer",
            "format" : "int32"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "kcal", "name" ]
      },
      "DietPlanResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "kcal" : {
            "type" : "integer",
            "format" : "int32"
          },
          "name" : {
            "type" : "string"
          },
          "state" : {
            "type" : "string",
            "enum" : [ "ACTIVE", "INACTIVE" ]
          }
        },
        "required" : [ "id", "kcal", "name", "state" ]
      }
    }
  }
}
