# Shared formatting rules for IntelliJ and ktlint (see docs/tasks/T-010-ktlint.md).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = intellij_idea
max_line_length = 120

# Classes with 2+ constructor parameters keep one parameter per line (readable data classes).
ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 2

# IntelliJ: never collapse imports into wildcards (ktlint rule "no-wildcard-imports" enforces the same).
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647
# Empty on purpose: "unset" would keep ktlint's default exceptions (e.g. java.util.*), empty forbids all wildcards.
ij_kotlin_packages_to_use_import_on_demand =
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{yml,yaml}]
indent_size = 2

[*.{ts,tsx,js,jsx,mjs,cjs,json,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
